# Backend the app talks to.
#   Production / TestFlight: the API Gateway mobile route (terraform output `mobile_api_base_url`),
#                            e.g. https://api.hetuengine.ai/app
#   Local development:       your machine's LAN IP, port 8000 (the backend directly, no gateway)
EXPO_PUBLIC_API_URL=http://192.168.1.157:8000

# Cognito user pool the app signs users in to (terraform outputs
# `mobile_cognito_user_pool_id` and `mobile_cognito_client_id`). Not secrets.
# A locally running backend must be configured with the same pool and client
# (COGNITO_APP_USER_POOL_ID / COGNITO_APP_CLIENT_ID in ifriend/.env).
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
EXPO_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
